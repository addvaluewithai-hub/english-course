{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://addvaluewithai-hub.github.io/english-course/schemas/learner-test-session-v1.json",
  "title": "Gold lesson learner-test session v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "study_id", "session_id", "lesson_id", "condition",
    "participant", "consent", "completion", "timing", "supports", "mastery",
    "correction", "experience", "issues", "data_controls"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "study_id": {"const": "gold_lesson_u1_l03_pilot_v1"},
    "session_id": {"type": "string", "pattern": "^LT1-[0-9]{3}$"},
    "lesson_id": {"const": "U1-L03"},
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["post_performance", "medium", "task_variant"],
      "properties": {
        "post_performance": {"enum": ["teachback", "omit"]},
        "medium": {"enum": ["video", "readable_equivalent"]},
        "task_variant": {"enum": ["study_group_primary", "community_event_replacement"]}
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adult_confirmed", "arabic_speaking", "entry_band", "eligible_primary_sample"],
      "properties": {
        "adult_confirmed": {"type": "boolean"},
        "arabic_speaking": {"type": "boolean"},
        "entry_band": {"enum": ["pre_a1", "a1", "a2_or_higher", "unknown"]},
        "eligible_primary_sample": {"type": "boolean"}
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["voluntary_confirmed", "data_boundary_confirmed", "participation_agreed", "raw_capture"],
      "properties": {
        "voluntary_confirmed": {"type": "boolean"},
        "data_boundary_confirmed": {"type": "boolean"},
        "participation_agreed": {"type": "boolean"},
        "raw_capture": {"const": false}
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "last_step", "fresh_task_attempted"],
      "properties": {
        "outcome": {"enum": ["completed", "stopped_incomplete", "safety_paused"]},
        "last_step": {"type": "integer", "minimum": 1, "maximum": 9},
        "fresh_task_attempted": {"type": "boolean"}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_seconds", "section_seconds"],
      "properties": {
        "total_seconds": {"type": "integer", "minimum": 0, "maximum": 7200},
        "section_seconds": {
          "type": "array", "minItems": 1, "maxItems": 9,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["step", "seconds"],
            "properties": {
              "step": {"type": "integer", "minimum": 1, "maximum": 9},
              "seconds": {"type": "integer", "minimum": 0, "maximum": 3600}
            }
          }
        }
      }
    },
    "supports": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["none", "repeat_prompt", "extra_time", "navigation", "simplified_instruction", "readable_equivalent", "construct_changed"]}
    },
    "mastery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_valid", "full_model_visible", "ratings", "decision"],
      "properties": {
        "evidence_valid": {"type": "boolean"},
        "full_model_visible": {"type": "boolean"},
        "ratings": {
          "type": "object", "additionalProperties": false,
          "required": ["comprehension", "outcome_performance", "context_transfer", "control_or_repair"],
          "properties": {
            "comprehension": {"type": ["integer", "null"], "minimum": 0, "maximum": 2},
            "outcome_performance": {"type": ["integer", "null"], "minimum": 0, "maximum": 2},
            "context_transfer": {"type": ["integer", "null"], "minimum": 0, "maximum": 2},
            "control_or_repair": {"type": ["integer", "null"], "minimum": 0, "maximum": 2}
          }
        },
        "decision": {"enum": ["demonstrated", "practiced", "needs_review", "not_rated"]}
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["important_corrections", "successful_immediate_retries"],
      "properties": {
        "important_corrections": {"type": "integer", "minimum": 0, "maximum": 10},
        "successful_immediate_retries": {"type": "integer", "minimum": 0, "maximum": 10}
      }
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arabic_clarity", "difficulty", "boredom", "perceived_value", "video_helpfulness", "teachback_helpfulness", "teachback_fatigue"],
      "properties": {
        "arabic_clarity": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "difficulty": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "boredom": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "perceived_value": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "video_helpfulness": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "teachback_helpfulness": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "teachback_fatigue": {"type": ["integer", "null"], "minimum": 1, "maximum": 5}
      }
    },
    "issues": {
      "type": "array", "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "severity", "note"],
        "properties": {
          "type": {"enum": ["instruction_confusion", "arabic_clarity", "level_fit", "video_value", "navigation", "correction", "retry", "mastery_construct", "teachback", "accessibility", "privacy", "safety"]},
          "severity": {"enum": ["info", "minor", "major", "severe"]},
          "note": {"type": "string", "maxLength": 240}
        }
      }
    },
    "data_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_raw_answer", "contains_direct_identifier", "withdrawal_route_given"],
      "properties": {
        "contains_raw_answer": {"const": false},
        "contains_direct_identifier": {"const": false},
        "withdrawal_route_given": {"type": "boolean"}
      }
    }
  }
}
