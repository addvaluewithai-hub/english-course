{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://addvaluewithai-hub.github.io/english-course/schemas/first-ten-progression-record-v1.json",
  "title": "First-ten A1 progression record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "study_id", "participant_code", "evidence_mode",
    "eligibility", "initial_consent", "media", "visits", "withdrawal", "privacy"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "study_id": {"const": "a1_first_10_progression_pilot_v1"},
    "participant_code": {"type": "string", "pattern": "^P10-[A-Z0-9]{4,8}$"},
    "evidence_mode": {"enum": ["real_observation", "synthetic_fixture"]},
    "eligibility": {"$ref": "#/$defs/eligibility"},
    "initial_consent": {"$ref": "#/$defs/consent"},
    "media": {"$ref": "#/$defs/media"},
    "visits": {
      "type": "array",
      "maxItems": 6,
      "items": {"$ref": "#/$defs/visit"}
    },
    "withdrawal": {"$ref": "#/$defs/withdrawal"},
    "privacy": {"$ref": "#/$defs/privacy"}
  },
  "$defs": {
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adult", "arabic_dominant", "beginner_boundary", "no_answer_material_exposure", "not_owner_or_author"],
      "properties": {
        "adult": {"type": "boolean"},
        "arabic_dominant": {"type": "boolean"},
        "beginner_boundary": {"type": "boolean"},
        "no_answer_material_exposure": {"type": "boolean"},
        "not_owner_or_author": {"type": "boolean"}
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["voluntary", "data_boundary_understood", "withdrawal_route_understood", "agreed"],
      "properties": {
        "voluntary": {"type": "boolean"},
        "data_boundary_understood": {"type": "boolean"},
        "withdrawal_route_understood": {"type": "boolean"},
        "agreed": {"type": "boolean"}
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "render_batch_id", "all_transcript_matched", "all_listened"],
      "properties": {
        "release_id": {"const": "a1_first_10_lessons_pilot_v1"},
        "render_batch_id": {"type": "string", "pattern": "^P10-MEDIA-[A-Z0-9._-]{3,32}$"},
        "all_transcript_matched": {"type": "boolean"},
        "all_listened": {"type": "boolean"}
      }
    },
    "visit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visit_number", "day_number", "consent_reaffirmed", "completion", "duration_seconds", "lesson_records", "unit1_stations", "delayed_probes"],
      "properties": {
        "visit_number": {"type": "integer", "minimum": 1, "maximum": 6},
        "day_number": {"type": "integer", "minimum": 1, "maximum": 12},
        "consent_reaffirmed": {"type": "boolean"},
        "completion": {"enum": ["completed", "paused", "stopped", "withdrawn", "safety_paused"]},
        "duration_seconds": {"type": "integer", "minimum": 0, "maximum": 3600},
        "lesson_records": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/lesson_record"}},
        "unit1_stations": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/station"}},
        "delayed_probes": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/probe"}}
      }
    },
    "lesson_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lesson_id", "completed", "duration_seconds", "help", "primary", "replacement", "experience", "issue_codes"],
      "properties": {
        "lesson_id": {"enum": ["U1-L01", "U1-L02", "U1-L03", "U1-L04", "U1-L05", "U1-L06", "U1-L07", "U1-L08", "U1-L09", "U2-L01"]},
        "completed": {"type": "boolean"},
        "duration_seconds": {"type": "integer", "minimum": 0, "maximum": 3600},
        "help": {
          "type": "object", "additionalProperties": false,
          "required": ["non_answer_revealing_count", "answer_revealing_count"],
          "properties": {
            "non_answer_revealing_count": {"type": "integer", "minimum": 0, "maximum": 20},
            "answer_revealing_count": {"type": "integer", "minimum": 0, "maximum": 20}
          }
        },
        "primary": {"$ref": "#/$defs/attempt"},
        "replacement": {"$ref": "#/$defs/attempt"},
        "experience": {"$ref": "#/$defs/experience"},
        "issue_codes": {
          "type": "array", "uniqueItems": true, "maxItems": 8,
          "items": {"enum": ["none", "instruction_confusion", "arabic_clarity", "level_fit", "video_value", "navigation", "fatigue", "mastery_construct", "accessibility", "privacy", "safety"]}
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "answer_model_visible", "ratings", "decision", "secondary_decision", "exact_agreement"],
      "properties": {
        "attempted": {"type": "boolean"},
        "answer_model_visible": {"type": "boolean"},
        "ratings": {"$ref": "#/$defs/ratings"},
        "decision": {"enum": ["demonstrated", "practiced", "needs_review", "not_rated"]},
        "secondary_decision": {"type": ["string", "null"], "enum": ["demonstrated", "practiced", "needs_review", "not_rated", null]},
        "exact_agreement": {"type": ["boolean", "null"]}
      }
    },
    "ratings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comprehension", "outcome", "transfer", "control_or_repair"],
      "properties": {
        "comprehension": {"type": ["integer", "null"], "minimum": 0, "maximum": 2},
        "outcome": {"type": ["integer", "null"], "minimum": 0, "maximum": 2},
        "transfer": {"type": ["integer", "null"], "minimum": 0, "maximum": 2},
        "control_or_repair": {"type": ["integer", "null"], "minimum": 0, "maximum": 2}
      }
    },
    "experience": {
      "type": "object", "additionalProperties": false,
      "required": ["difficulty", "fatigue", "boredom", "perceived_value"],
      "properties": {
        "difficulty": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "fatigue": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "boredom": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
        "perceived_value": {"type": ["integer", "null"], "minimum": 1, "maximum": 5}
      }
    },
    "station": {
      "type": "object", "additionalProperties": false,
      "required": ["station_id", "decision"],
      "properties": {
        "station_id": {"enum": ["UNIT1-STATION-01", "UNIT1-STATION-02", "UNIT1-STATION-03"]},
        "decision": {"enum": ["demonstrated", "practiced", "needs_review", "not_rated"]}
      }
    },
    "probe": {
      "type": "object", "additionalProperties": false,
      "required": ["probe_id", "source_lesson_id", "days_since_lesson", "decision"],
      "properties": {
        "probe_id": {"type": "string", "pattern": "^P10-PROBE-[0-9]{2}$"},
        "source_lesson_id": {"enum": ["U1-L01", "U1-L02", "U1-L03", "U1-L04", "U1-L05", "U1-L06", "U1-L07", "U1-L08", "U1-L09", "U2-L01"]},
        "days_since_lesson": {"type": "integer", "minimum": 1, "maximum": 12},
        "decision": {"enum": ["demonstrated", "practiced", "needs_review", "not_rated"]}
      }
    },
    "withdrawal": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "after_visit", "reason_code"],
      "properties": {
        "status": {"enum": ["active", "completed", "withdrew"]},
        "after_visit": {"type": ["integer", "null"], "minimum": 0, "maximum": 6},
        "reason_code": {"type": ["string", "null"], "enum": ["participant_choice", "schedule", "fatigue", "safety", "eligibility", "technical", null]}
      }
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["contains_direct_identifier", "contains_raw_answer", "contains_audio", "contains_video", "stored_outside_repository"],
      "properties": {
        "contains_direct_identifier": {"const": false},
        "contains_raw_answer": {"const": false},
        "contains_audio": {"const": false},
        "contains_video": {"const": false},
        "stored_outside_repository": {"const": true}
      }
    }
  }
}
