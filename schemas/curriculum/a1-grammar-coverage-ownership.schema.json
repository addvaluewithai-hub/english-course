{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-course.local/schemas/a1-grammar-coverage-ownership.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "version", "inputs", "policy", "course_items", "source_dispositions", "legacy_target_crosswalk", "audit", "review"],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"const": "a1_grammar_coverage_ownership"},
    "version": {"const": 1},
    "inputs": {
      "type": "array",
      "minItems": 6,
      "items": {"$ref": "#/$defs/input"}
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_role", "course_item_role", "ownership_status", "variety_policy", "assessment_policy"],
      "properties": {
        "source_role": {"type": "string", "minLength": 20},
        "course_item_role": {"type": "string", "minLength": 20},
        "ownership_status": {"type": "string", "minLength": 20},
        "variety_policy": {"type": "string", "minLength": 20},
        "assessment_policy": {"type": "string", "minLength": 20}
      }
    },
    "course_items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    },
    "source_dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/disposition"}
    },
    "legacy_target_crosswalk": {
      "type": "array",
      "items": {"$ref": "#/$defs/crosswalk"}
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["egp_a1_source_count", "gse_grammar_a1_source_count", "total_source_count", "course_item_count", "control_status_counts", "disposition_counts", "legacy_target_count", "new_system_item_ids", "orphan_source_ids", "unknown_course_item_ids", "unknown_owner_ids", "items_without_source_evidence", "items_without_recycle_owners", "unmapped_legacy_candidate_ids", "final_lesson_decisions_made"],
      "properties": {
        "egp_a1_source_count": {"const": 109},
        "gse_grammar_a1_source_count": {"const": 43},
        "total_source_count": {"const": 152},
        "course_item_count": {"type": "integer", "minimum": 1},
        "control_status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "disposition_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "legacy_target_count": {"type": "integer", "minimum": 0},
        "new_system_item_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "orphan_source_ids": {"type": "array", "maxItems": 0},
        "unknown_course_item_ids": {"type": "array", "maxItems": 0},
        "unknown_owner_ids": {"type": "array", "maxItems": 0},
        "items_without_source_evidence": {"type": "array", "maxItems": 0},
        "items_without_recycle_owners": {"type": "array", "maxItems": 0},
        "unmapped_legacy_candidate_ids": {"type": "array", "maxItems": 0},
        "final_lesson_decisions_made": {"const": 0}
      }
    },
    "review": {"$ref": "#/$defs/review"}
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_count", "egp_feature_ids", "gse_grammar_record_ids"],
      "properties": {
        "source_count": {"type": "integer", "minimum": 1},
        "egp_feature_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "gse_grammar_record_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "title", "control_status", "exact_forms", "meaning_use", "introduction_owner_ids", "recycle_owner_ids", "mastery_evidence", "not_yet", "decision_status", "source_evidence"],
      "properties": {
        "item_id": {"type": "string", "pattern": "^grammar\\."},
        "title": {"type": "string", "minLength": 3},
        "control_status": {"enum": ["productive_core", "productive_limited", "formulaic_productive", "receptive_formulaic", "embedded_support"]},
        "exact_forms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
        "meaning_use": {"type": "string", "minLength": 10},
        "introduction_owner_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "recycle_owner_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "mastery_evidence": {"type": "string", "minLength": 15},
        "not_yet": {"type": "string", "minLength": 10},
        "decision_status": {"const": "accepted_for_a1_reconciliation"},
        "source_evidence": {"$ref": "#/$defs/sourceEvidence"}
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_system", "source_record_id", "source_level", "source_label", "source_text", "course_item_ids", "disposition", "rationale_code", "owner_ids"],
      "properties": {
        "source_system": {"enum": ["egp", "gse_grammar"]},
        "source_record_id": {"type": "string", "minLength": 3},
        "source_level": {"const": "A1"},
        "source_label": {"type": "string", "minLength": 2},
        "source_text": {"type": "string", "minLength": 5},
        "course_item_ids": {"type": "array", "items": {"type": "string", "pattern": "^grammar\\."}, "uniqueItems": true},
        "disposition": {"enum": ["selected_core", "selected_limited", "folded_duplicate", "support_not_separate", "transfer_phrase_layer", "transfer_lexical_layer", "transfer_writing_support"]},
        "rationale_code": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "owner_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "crosswalk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "legacy_target", "exact_item_ids"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^lesson_candidate\\."},
        "legacy_target": {"type": "string", "minLength": 3},
        "exact_item_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^grammar\\."}, "uniqueItems": true}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "reviewed_at", "statement"],
      "properties": {
        "status": {"const": "accepted_exact_language_system_pass"},
        "reviewer": {"type": "string", "minLength": 3},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "statement": {"type": "string", "minLength": 30}
      }
    }
  }
}
