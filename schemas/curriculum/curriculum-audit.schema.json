{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-course.local/schemas/curriculum/curriculum-audit.schema.json",
  "title": "A1 CUR-006 curriculum audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "audit_id", "status", "reviewed_at", "evidence",
    "coverage", "exclusions", "duplicate_groups", "prerequisite_audit",
    "balance", "verdict"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "audit_id": {"const": "a1_curriculum_audit_cur_006"},
    "status": {"const": "accepted_phase_2_gate"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_map_id", "dataset_ids"],
      "properties": {
        "candidate_map_id": {"const": "a1_candidate_unit_map_cur_005"},
        "dataset_ids": {
          "type": "array", "minItems": 2, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "coverage": {"$ref": "#/$defs/coverage"},
    "exclusions": {
      "type": "array",
      "items": {"$ref": "#/$defs/exclusion"}
    },
    "duplicate_groups": {
      "type": "array",
      "items": {"$ref": "#/$defs/duplicateGroup"}
    },
    "prerequisite_audit": {"$ref": "#/$defs/prerequisiteAudit"},
    "balance": {"$ref": "#/$defs/balance"},
    "verdict": {"$ref": "#/$defs/verdict"}
  },
  "$defs": {
    "stringArray": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "countMap": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "recordRef": {
      "type": "object", "additionalProperties": false,
      "required": [
        "record_id", "dataset_id", "raw_file", "location", "source_text_sha256"
      ],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "dataset_id": {"type": "string", "minLength": 1},
        "raw_file": {"type": "string", "pattern": "^sources/raw/"},
        "location": {"type": "object"},
        "source_text_sha256": {
          "type": "string", "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": [
        "reviewed_record_count", "included_count", "excluded_count",
        "mapped_included_count", "traceable_assignment_count",
        "unmapped_included_ids", "mapped_excluded_ids", "assignment_orphan_ids",
        "source_orphan_ids", "empty_cluster_ids",
        "candidate_clusters_without_objectives",
        "candidate_clusters_without_descriptors"
      ],
      "properties": {
        "reviewed_record_count": {"type": "integer", "minimum": 1},
        "included_count": {"type": "integer", "minimum": 1},
        "excluded_count": {"type": "integer", "minimum": 0},
        "mapped_included_count": {"type": "integer", "minimum": 0},
        "traceable_assignment_count": {"type": "integer", "minimum": 1},
        "unmapped_included_ids": {"$ref": "#/$defs/stringArray"},
        "mapped_excluded_ids": {"$ref": "#/$defs/stringArray"},
        "assignment_orphan_ids": {"$ref": "#/$defs/stringArray"},
        "source_orphan_ids": {"$ref": "#/$defs/stringArray"},
        "empty_cluster_ids": {"$ref": "#/$defs/stringArray"},
        "candidate_clusters_without_objectives": {"$ref": "#/$defs/stringArray"},
        "candidate_clusters_without_descriptors": {"$ref": "#/$defs/stringArray"}
      }
    },
    "exclusion": {
      "type": "object", "additionalProperties": false,
      "required": [
        "record_id", "dataset_id", "raw_file", "location",
        "source_text_sha256", "reason"
      ],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "dataset_id": {"type": "string", "minLength": 1},
        "raw_file": {"type": "string", "pattern": "^sources/raw/"},
        "location": {"type": "object"},
        "source_text_sha256": {
          "type": "string", "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "duplicateGroup": {
      "type": "object", "additionalProperties": false,
      "required": [
        "group_id", "record_refs", "resolution", "canonical_record_id", "rationale"
      ],
      "properties": {
        "group_id": {"type": "string", "pattern": "^duplicate_[a-f0-9]{12}$"},
        "record_refs": {
          "type": "array", "minItems": 2,
          "items": {"$ref": "#/$defs/recordRef"}
        },
        "resolution": {
          "enum": [
            "exclude_repeated_source_row",
            "retain_distinct_scale_placements",
            "unresolved"
          ]
        },
        "canonical_record_id": {"type": ["string", "null"], "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "supportNeed": {
      "type": "object", "additionalProperties": false,
      "required": [
        "need_id", "support_cluster_id", "summary",
        "target_cluster_ids", "evidence_refs"
      ],
      "properties": {
        "need_id": {"type": "string", "minLength": 1},
        "support_cluster_id": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "target_cluster_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence_refs": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/recordRef"}
        }
      }
    },
    "prerequisiteAudit": {
      "type": "object", "additionalProperties": false,
      "required": [
        "strict_cluster_prerequisites", "support_needs",
        "sequencing_status", "finding"
      ],
      "properties": {
        "strict_cluster_prerequisites": {"type": "array", "maxItems": 0},
        "support_needs": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/supportNeed"}
        },
        "sequencing_status": {
          "const": "deferred_to_phase_3_lesson_normalization"
        },
        "finding": {"type": "string", "minLength": 1}
      }
    },
    "kindBalance": {
      "type": "object", "additionalProperties": false,
      "required": ["record_count", "skill_counts", "mode_counts"],
      "properties": {
        "record_count": {"type": "integer", "minimum": 0},
        "skill_counts": {"$ref": "#/$defs/countMap"},
        "mode_counts": {"$ref": "#/$defs/countMap"}
      }
    },
    "clusterBalance": {
      "type": "object", "additionalProperties": false,
      "required": [
        "cluster_id", "role", "objective_count", "descriptor_count",
        "objective_skill_counts", "descriptor_skill_counts",
        "combined_skill_counts", "objective_skill_gaps",
        "descriptor_skill_gaps", "combined_skill_gaps"
      ],
      "properties": {
        "cluster_id": {"type": "string", "minLength": 1},
        "role": {"enum": ["candidate_unit", "cross_cutting_support"]},
        "objective_count": {"type": "integer", "minimum": 0},
        "descriptor_count": {"type": "integer", "minimum": 0},
        "objective_skill_counts": {"$ref": "#/$defs/countMap"},
        "descriptor_skill_counts": {"$ref": "#/$defs/countMap"},
        "combined_skill_counts": {"$ref": "#/$defs/countMap"},
        "objective_skill_gaps": {"$ref": "#/$defs/stringArray"},
        "descriptor_skill_gaps": {"$ref": "#/$defs/stringArray"},
        "combined_skill_gaps": {"$ref": "#/$defs/stringArray"}
      }
    },
    "balance": {
      "type": "object", "additionalProperties": false,
      "required": ["core_skills", "overall", "clusters", "findings"],
      "properties": {
        "core_skills": {"$ref": "#/$defs/stringArray"},
        "overall": {
          "type": "object", "additionalProperties": false,
          "required": ["objective", "descriptor"],
          "properties": {
            "objective": {"$ref": "#/$defs/kindBalance"},
            "descriptor": {"$ref": "#/$defs/kindBalance"}
          }
        },
        "clusters": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/clusterBalance"}
        },
        "findings": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "verdict": {
      "type": "object", "additionalProperties": false,
      "required": [
        "coverage_complete", "exclusions_justified", "duplicates_reconciled",
        "skill_gaps_documented", "phase_2_gate", "constraints"
      ],
      "properties": {
        "coverage_complete": {"const": true},
        "exclusions_justified": {"const": true},
        "duplicates_reconciled": {"const": true},
        "skill_gaps_documented": {"const": true},
        "phase_2_gate": {"const": "passed"},
        "constraints": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
