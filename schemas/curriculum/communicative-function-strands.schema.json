{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-course.local/schemas/curriculum/communicative-function-strands.schema.json",
  "title": "Reviewed communicative-function progression strands",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "dataset_id", "version", "level_order", "lifecycle_order",
    "inputs", "strands", "audit", "review"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"const": "communicative_function_progression_strands"},
    "version": {"const": 1},
    "level_order": {
      "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true,
      "items": {"$ref": "#/$defs/level"}
    },
    "lifecycle_order": {
      "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true,
      "items": {"$ref": "#/$defs/lifecycleState"}
    },
    "inputs": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"$ref": "#/$defs/input"}
    },
    "strands": {
      "type": "array", "minItems": 41, "maxItems": 41,
      "items": {"$ref": "#/$defs/strand"}
    },
    "audit": {"$ref": "#/$defs/audit"},
    "review": {"$ref": "#/$defs/review"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "stringList": {
      "type": "array", "items": {"$ref": "#/$defs/text"}, "uniqueItems": true
    },
    "level": {"enum": ["pre_a1", "a1", "a2", "b1", "b2", "c1", "c2"]},
    "exitLevel": {"enum": ["a1", "a2", "b1", "b2", "c1", "c2"]},
    "lifecycleState": {"enum": ["expose", "introduce", "practise", "recycle", "consolidate", "extend"]},
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^data/reviewed/"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": [
        "assignment_count", "assignment_ids_sha256", "representative_assignment_ids",
        "source_levels", "source_datasets"
      ],
      "properties": {
        "assignment_count": {"type": "integer", "minimum": 1},
        "assignment_ids_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "representative_assignment_ids": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": {"$ref": "#/$defs/text"}, "uniqueItems": true
        },
        "source_levels": {
          "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/level"},
          "uniqueItems": true
        },
        "source_datasets": {"$ref": "#/$defs/stringList"}
      }
    },
    "stage": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "evidence_count", "evidence_status", "control_expectation", "lifecycle_states"],
      "properties": {
        "level": {"$ref": "#/$defs/level"},
        "evidence_count": {"type": "integer", "minimum": 0},
        "evidence_status": {"enum": ["source_evidenced", "planned_recycle"]},
        "control_expectation": {"enum": ["receptive", "productive", "both"]},
        "lifecycle_states": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/lifecycleState"}
        }
      }
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": [
        "first_exposure_level", "first_receptive_control_level",
        "first_productive_control_level", "consolidation_level", "recycle_levels",
        "extension_levels", "within_level_order_required", "stages", "rationale"
      ],
      "properties": {
        "first_exposure_level": {"$ref": "#/$defs/level"},
        "first_receptive_control_level": {"oneOf": [{"$ref": "#/$defs/exitLevel"}, {"type": "null"}]},
        "first_productive_control_level": {"oneOf": [{"$ref": "#/$defs/exitLevel"}, {"type": "null"}]},
        "consolidation_level": {"$ref": "#/$defs/exitLevel"},
        "recycle_levels": {"type": "array", "items": {"$ref": "#/$defs/exitLevel"}, "uniqueItems": true},
        "extension_levels": {"type": "array", "items": {"$ref": "#/$defs/exitLevel"}, "uniqueItems": true},
        "within_level_order_required": {"const": true},
        "stages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stage"}},
        "rationale": {"$ref": "#/$defs/text"}
      }
    },
    "strand": {
      "type": "object", "additionalProperties": false,
      "required": [
        "strand_id", "function_code", "title", "curriculum_intent", "strand_role",
        "evidence", "lifecycle", "review"
      ],
      "properties": {
        "strand_id": {"type": "string", "pattern": "^function\\.[a-z0-9_]+$"},
        "function_code": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "title": {"$ref": "#/$defs/text"},
        "curriculum_intent": {"$ref": "#/$defs/text"},
        "strand_role": {"enum": ["receptive", "communicative", "mediation", "support_strategy", "language_system_support"]},
        "evidence": {"$ref": "#/$defs/evidence"},
        "lifecycle": {"$ref": "#/$defs/lifecycle"},
        "review": {"$ref": "#/$defs/strandReview"}
      }
    },
    "strandReview": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "review_basis"],
      "properties": {
        "status": {"const": "accepted"},
        "review_basis": {"const": "source_level_boundary_plus_persistence_policy"}
      }
    },
    "audit": {
      "type": "object", "additionalProperties": false,
      "required": [
        "strand_count", "source_assignment_count", "evidence_link_count",
        "uncovered_assignments", "missing_consolidation", "invalid_level_regressions",
        "missing_post_consolidation_recycle"
      ],
      "properties": {
        "strand_count": {"const": 41},
        "source_assignment_count": {"const": 2274},
        "evidence_link_count": {"type": "integer", "minimum": 2274},
        "uncovered_assignments": {"type": "array", "maxItems": 0},
        "missing_consolidation": {"type": "array", "maxItems": 0},
        "invalid_level_regressions": {"type": "array", "maxItems": 0},
        "missing_post_consolidation_recycle": {"type": "array", "maxItems": 0}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reviewer", "reviewed_at", "method", "limitations"],
      "properties": {
        "status": {"const": "accepted"},
        "reviewer": {"const": "codex_primary_curriculum_agent"},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "method": {"const": "source_boundary_derived_lifecycle_plus_persistence_review"},
        "limitations": {"$ref": "#/$defs/stringList"}
      }
    }
  }
}
