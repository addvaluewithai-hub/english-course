{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-course.local/schemas/curriculum/a1-reconciliation-worklist.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "worklist_id", "version", "inputs", "decision_codes", "review_passes", "candidates", "audit", "review"],
  "properties": {
    "schema_version": {"const": 1}, "worklist_id": {"const": "a1_reconciliation_worklist"}, "version": {"const": 1},
    "inputs": {"type": "array", "minItems": 11, "maxItems": 11, "items": {"$ref": "#/$defs/input"}},
    "decision_codes": {"const": ["keep", "revise", "split", "merge", "defer", "support_only", "replace", "retire"]},
    "review_passes": {"const": ["outcome_and_level_fit", "global_ability_coverage", "grammar_ownership", "vocabulary_and_chunk_ownership", "pronunciation_progression", "sequence_and_recycling", "mastery_and_exit_assessment"]},
    "candidates": {"type": "array", "minItems": 81, "maxItems": 81, "items": {"$ref": "#/$defs/candidate"}},
    "audit": {"$ref": "#/$defs/audit"}, "review": {"$ref": "#/$defs/review"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "candidateId": {"type": "string", "pattern": "^lesson_candidate\\.[a-z0-9_]+$"},
    "input": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
    },
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["situation", "observable_action", "essential_content", "independence", "success_condition", "statement"],
      "properties": {
        "situation": {"$ref": "#/$defs/text"}, "observable_action": {"$ref": "#/$defs/text"},
        "essential_content": {"$ref": "#/$defs/text"}, "independence": {"$ref": "#/$defs/text"},
        "success_condition": {"$ref": "#/$defs/text"}, "statement": {"$ref": "#/$defs/text"}
      }
    },
    "levelFit": {
      "type": "object", "additionalProperties": false,
      "required": ["matched_source_ref_count", "matched_all_level_record_ids", "unmatched_record_ids", "all_level_codes", "above_a1_level_codes", "status"],
      "properties": {
        "matched_source_ref_count": {"type": "integer", "minimum": 1},
        "matched_all_level_record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "unmatched_record_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "all_level_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["pre_a1", "a1", "a2", "b1", "b2", "c1", "c2"]}},
        "above_a1_level_codes": {"type": "array", "uniqueItems": true, "items": {"enum": ["a2", "b1", "b2", "c1", "c2"]}},
        "status": {"enum": ["a1_only_evidence", "a1_with_pre_a1_support", "mixed_level_evidence_review", "missing_all_level_match"]}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["record_count", "record_ids", "level_fit"],
      "properties": {
        "record_count": {"type": "integer", "minimum": 1},
        "record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "level_fit": {"$ref": "#/$defs/levelFit"}
      }
    },
    "targets": {
      "type": "object", "additionalProperties": false, "required": ["grammar", "vocabulary", "phrases", "pronunciation"],
      "properties": {
        "grammar": {"$ref": "#/$defs/textArray"}, "vocabulary": {"$ref": "#/$defs/textArray"},
        "phrases": {"$ref": "#/$defs/textArray"}, "pronunciation": {"$ref": "#/$defs/textArray"}
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false, "required": ["grammar", "vocabulary", "phrases", "pronunciation"],
      "properties": {
        "grammar": {"type": "integer", "minimum": 0}, "vocabulary": {"type": "integer", "minimum": 0},
        "phrases": {"type": "integer", "minimum": 0}, "pronunciation": {"type": "integer", "minimum": 0}
      }
    },
    "relationships": {
      "type": "object", "additionalProperties": false,
      "required": ["required_before", "helpful_before", "successors", "concurrent_support"],
      "properties": {
        "required_before": {"$ref": "#/$defs/idArray"}, "helpful_before": {"$ref": "#/$defs/idArray"},
        "successors": {"$ref": "#/$defs/idArray"},
        "concurrent_support": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^support\\.[a-z0-9_]+$"}}
      }
    },
    "mastery": {
      "type": "object", "additionalProperties": false, "required": ["fresh_task_family", "critical_failures", "delayed_probe"],
      "properties": {
        "fresh_task_family": {"$ref": "#/$defs/text"},
        "critical_failures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "delayed_probe": {"$ref": "#/$defs/text"}
      }
    },
    "unit": {
      "type": "object", "additionalProperties": false, "required": ["included", "lesson_id", "package_status"],
      "properties": {
        "included": {"type": "boolean"}, "lesson_id": {"type": ["string", "null"]},
        "package_status": {"type": ["string", "null"]}
      }
    },
    "reconciliation": {
      "type": "object", "additionalProperties": false,
      "required": ["review_status", "decision", "rationale", "related_candidate_ids", "unresolved_questions"],
      "properties": {
        "review_status": {"enum": ["pending", "in_review", "reviewed"]},
        "decision": {"type": ["string", "null"], "enum": [null, "keep", "revise", "split", "merge", "defer", "support_only", "replace", "retire"]},
        "rationale": {"type": ["string", "null"]}, "related_candidate_ids": {"$ref": "#/$defs/idArray"},
        "unresolved_questions": {"$ref": "#/$defs/textArray"}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "original_sequence_position", "current_internal_status", "cluster_ids", "outcome", "skill_codes", "mode_codes", "function_codes", "evidence", "current_language_targets", "current_target_counts", "current_error_hypothesis_count", "current_relationships", "current_mastery", "unit1_membership", "reconciliation"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/candidateId"}, "original_sequence_position": {"type": "integer", "minimum": 1, "maximum": 81},
        "current_internal_status": {"$ref": "#/$defs/text"}, "cluster_ids": {"$ref": "#/$defs/textArray"},
        "outcome": {"$ref": "#/$defs/outcome"}, "skill_codes": {"$ref": "#/$defs/textArray"},
        "mode_codes": {"$ref": "#/$defs/textArray"}, "function_codes": {"$ref": "#/$defs/textArray"},
        "evidence": {"$ref": "#/$defs/evidence"}, "current_language_targets": {"$ref": "#/$defs/targets"},
        "current_target_counts": {"$ref": "#/$defs/counts"}, "current_error_hypothesis_count": {"type": "integer", "minimum": 1},
        "current_relationships": {"$ref": "#/$defs/relationships"}, "current_mastery": {"$ref": "#/$defs/mastery"},
        "unit1_membership": {"$ref": "#/$defs/unit"}, "reconciliation": {"$ref": "#/$defs/reconciliation"}
      }
    },
    "audit": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_count", "unit1_candidate_count", "unique_sequence_positions", "source_level_fit_counts", "unmatched_evidence_record_ids", "unknown_unit1_candidate_ids", "decision_counts"],
      "properties": {
        "candidate_count": {"const": 81}, "unit1_candidate_count": {"const": 8}, "unique_sequence_positions": {"const": 81},
        "source_level_fit_counts": {"const": {"a1_only_evidence": 81}},
        "unmatched_evidence_record_ids": {"type": "array", "maxItems": 0},
        "unknown_unit1_candidate_ids": {"type": "array", "maxItems": 0},
        "decision_counts": {"type": "object", "additionalProperties": false, "required": ["pending"], "properties": {"pending": {"const": 81}}}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false, "required": ["status", "reviewer", "created_at", "statement"],
      "properties": {
        "status": {"const": "worklist_ready"}, "reviewer": {"const": "codex_primary_curriculum_agent"},
        "created_at": {"type": "string", "format": "date-time"}, "statement": {"$ref": "#/$defs/text"}
      }
    },
    "idArray": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/candidateId"}},
    "textArray": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
  }
}
