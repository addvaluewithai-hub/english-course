{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-course.local/schemas/curriculum/a1-prerequisite-recycling-mastery-exit-audit.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "audit_id", "version", "inputs", "policy", "provisional_sequence", "explicit_dependency_edges", "exact_item_sequence", "candidate_ownership_impacts", "mastery_reviews", "exit_safeguards", "audit", "review"],
  "properties": {
    "schema_version": {"const": 1},
    "audit_id": {"const": "a1_prerequisite_recycling_mastery_exit_audit"},
    "version": {"const": 1},
    "inputs": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/input"}},
    "policy": {"$ref": "#/$defs/policy"},
    "provisional_sequence": {"type": "array", "minItems": 81, "maxItems": 81, "uniqueItems": true, "items": {"$ref": "#/$defs/candidateId"}},
    "explicit_dependency_edges": {"type": "array", "minItems": 48, "maxItems": 48, "items": {"$ref": "#/$defs/edge"}},
    "exact_item_sequence": {"type": "array", "minItems": 158, "maxItems": 158, "items": {"$ref": "#/$defs/item"}},
    "candidate_ownership_impacts": {"type": "array", "minItems": 81, "maxItems": 81, "items": {"$ref": "#/$defs/impact"}},
    "mastery_reviews": {"type": "array", "minItems": 81, "maxItems": 81, "items": {"$ref": "#/$defs/mastery"}},
    "exit_safeguards": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/exit"}},
    "audit": {"$ref": "#/$defs/audit"},
    "review": {"$ref": "#/$defs/review"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "candidateId": {"type": "string", "pattern": "^lesson_candidate\\.[a-z0-9_]+$"},
    "candidateIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/candidateId"}},
    "locationId": {"type": "string", "pattern": "^(lesson_candidate|support)\\.[a-z0-9_]+$"},
    "locationIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/locationId"}},
    "itemIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(grammar|lexical|a1_pronunciation)\\.[a-z0-9_]+$"}},
    "input": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence_status", "ownership_transfer_rule", "recycling_rule", "mastery_rule", "exit_rule"],
      "properties": {
        "sequence_status": {"const": "provisional_not_locked"},
        "ownership_transfer_rule": {"$ref": "#/$defs/text"}, "recycling_rule": {"$ref": "#/$defs/text"},
        "mastery_rule": {"$ref": "#/$defs/text"}, "exit_rule": {"$ref": "#/$defs/text"}
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "relationship", "dependency_id", "dependency_position", "candidate_position", "status"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/candidateId"}, "relationship": {"enum": ["required_before", "helpful_before"]},
        "dependency_id": {"$ref": "#/$defs/candidateId"}, "dependency_position": {"type": "integer", "minimum": 1, "maximum": 81},
        "candidate_position": {"type": "integer", "minimum": 1, "maximum": 81}, "status": {"enum": ["aligned", "requires_resolution"]}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["system", "item_id", "introduction_location_ids", "recycle_location_ids", "earliest_introduction_position", "early_recycle_location_ids", "later_recycle_location_ids", "status"],
      "properties": {
        "system": {"enum": ["grammar", "lexical", "pronunciation"]},
        "item_id": {"type": "string", "pattern": "^(grammar|lexical|a1_pronunciation)\\.[a-z0-9_]+$"},
        "introduction_location_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/locationId"}},
        "recycle_location_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/locationId"}},
        "earliest_introduction_position": {"type": "integer", "minimum": 1, "maximum": 82},
        "early_recycle_location_ids": {"$ref": "#/$defs/locationIds"}, "later_recycle_location_ids": {"$ref": "#/$defs/locationIds"},
        "status": {"enum": ["aligned", "early_use_requires_introduction_transfer_or_reorder", "no_later_recycle_requires_reorder_or_new_recycle"]}
      }
    },
    "impact": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "provisional_position", "architecture_hypothesis", "introduction_item_ids", "recycle_item_ids", "transfer_required_if_merged_supported_or_retired"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/candidateId"}, "provisional_position": {"type": "integer", "minimum": 1, "maximum": 81},
        "architecture_hypothesis": {"enum": ["standalone_plausible", "merge_review", "support_only_review", "unit_synthesis_review", "split_review", "replace_or_reframe_review"]},
        "introduction_item_ids": {"$ref": "#/$defs/itemIds"}, "recycle_item_ids": {"$ref": "#/$defs/itemIds"},
        "transfer_required_if_merged_supported_or_retired": {"const": true}
      }
    },
    "mastery": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "fresh_task_family", "critical_failure_count", "delayed_probe", "structural_status", "construct_alignment_status", "risk_codes", "required_revision_actions", "no_answer_revealing_support_required"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/candidateId"}, "fresh_task_family": {"$ref": "#/$defs/text"},
        "critical_failure_count": {"type": "integer", "minimum": 1}, "delayed_probe": {"$ref": "#/$defs/text"},
        "structural_status": {"const": "complete"}, "construct_alignment_status": {"enum": ["aligned_with_current_outcome", "requires_scope_or_construct_revision"]},
        "risk_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
        "required_revision_actions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "no_answer_revealing_support_required": {"const": true}
      }
    },
    "exit": {
      "type": "object", "additionalProperties": false,
      "required": ["dimension_code", "current_owner_count", "protected_capability_anchor_ids", "all_anchors_are_current_owners", "survival_rule"],
      "properties": {
        "dimension_code": {"enum": ["listening_reception", "reading_reception", "speaking_production", "writing_production", "oral_interaction", "written_online_interaction", "mediation"]},
        "current_owner_count": {"type": "integer", "minimum": 1}, "protected_capability_anchor_ids": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/candidateId"}},
        "all_anchors_are_current_owners": {"const": true}, "survival_rule": {"$ref": "#/$defs/text"}
      }
    },
    "audit": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_count", "explicit_dependency_edge_count", "aligned_explicit_dependency_edges", "unresolved_explicit_dependency_edges", "unit1_order_findings_carried_forward", "exact_item_count", "exact_item_sequence_status_counts", "items_requiring_sequence_resolution", "candidates_with_exact_item_roles", "structurally_complete_mastery_records", "mastery_constructs_aligned", "mastery_constructs_requiring_revision", "protected_exit_dimension_count", "unknown_location_ids", "final_candidate_decisions_made"],
      "properties": {
        "candidate_count": {"const": 81}, "explicit_dependency_edge_count": {"const": 48}, "aligned_explicit_dependency_edges": {"const": 48},
        "unresolved_explicit_dependency_edges": {"const": 0}, "unit1_order_findings_carried_forward": {"const": 1}, "exact_item_count": {"const": 158},
        "exact_item_sequence_status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "items_requiring_sequence_resolution": {"type": "integer", "minimum": 0}, "candidates_with_exact_item_roles": {"const": 81},
        "structurally_complete_mastery_records": {"const": 81}, "mastery_constructs_aligned": {"const": 67}, "mastery_constructs_requiring_revision": {"const": 14},
        "protected_exit_dimension_count": {"const": 7}, "unknown_location_ids": {"type": "array", "maxItems": 0}, "final_candidate_decisions_made": {"const": 0}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false, "required": ["status", "reviewer", "reviewed_at", "statement"],
      "properties": {"status": {"const": "accepted_for_final_candidate_decisions"}, "reviewer": {"const": "codex_primary_curriculum_agent"}, "reviewed_at": {"type": "string", "format": "date-time"}, "statement": {"$ref": "#/$defs/text"}}
    }
  }
}
