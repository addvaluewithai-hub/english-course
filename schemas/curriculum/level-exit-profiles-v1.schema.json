{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://english-course.local/schemas/curriculum/level-exit-profiles-v1.schema.json",
  "title": "Approved A1-C2 level exit profiles",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "profile_set_id", "version", "status", "exit_levels",
    "onboarding_support", "internal_milestones", "lifecycle", "evidence_bundles",
    "levels", "review"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "profile_set_id": {"const": "english_course_level_exit_profiles"},
    "version": {"const": 1},
    "status": {"const": "approved"},
    "exit_levels": {
      "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true,
      "items": {"enum": ["a1", "a2", "b1", "b2", "c1", "c2"]}
    },
    "onboarding_support": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "role", "exit_claim"],
      "properties": {
        "level": {"const": "pre_a1"}, "role": {"type": "string", "minLength": 1},
        "exit_claim": {"const": false}
      }
    },
    "internal_milestones": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"$ref": "#/$defs/milestone"}
    },
    "lifecycle": {
      "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true,
      "items": {"enum": ["expose", "introduce", "practise", "recycle", "consolidate", "extend"]}
    },
    "evidence_bundles": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "data/reviewed/level-exit-evidence-v1.json"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "levels": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {"$ref": "#/$defs/levelProfile"}
    },
    "review": {"$ref": "#/$defs/review"}
  },
  "$defs": {
    "claim": {"$ref": "https://english-course.local/schemas/curriculum/profile-claim.schema.json"},
    "milestone": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "gse_range", "role"],
      "properties": {
        "id": {"enum": ["a2_plus", "b1_plus", "b2_plus"]},
        "gse_range": {"type": "string", "pattern": "^[0-9]{2}-[0-9]{2}$"},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "claimPair": {
      "type": "object", "additionalProperties": false,
      "required": ["listening", "reading"],
      "properties": {"listening": {"$ref": "#/$defs/claim"}, "reading": {"$ref": "#/$defs/claim"}}
    },
    "production": {
      "type": "object", "additionalProperties": false,
      "required": ["speaking", "writing"],
      "properties": {"speaking": {"$ref": "#/$defs/claim"}, "writing": {"$ref": "#/$defs/claim"}}
    },
    "interaction": {
      "type": "object", "additionalProperties": false,
      "required": ["oral", "written_online", "mediation"],
      "properties": {
        "oral": {"$ref": "#/$defs/claim"}, "written_online": {"$ref": "#/$defs/claim"},
        "mediation": {"$ref": "#/$defs/claim"}
      }
    },
    "languageControl": {
      "type": "object", "additionalProperties": false,
      "required": ["range", "grammar", "vocabulary", "pronunciation", "discourse", "fluency"],
      "properties": {
        "range": {"$ref": "#/$defs/claim"}, "grammar": {"$ref": "#/$defs/claim"},
        "vocabulary": {"$ref": "#/$defs/claim"}, "pronunciation": {"$ref": "#/$defs/claim"},
        "discourse": {"$ref": "#/$defs/claim"}, "fluency": {"$ref": "#/$defs/claim"}
      }
    },
    "levelProfile": {
      "type": "object", "additionalProperties": false,
      "required": [
        "level", "progression_index", "gse_range", "title", "exit_promise", "reception", "production",
        "interaction", "language_control", "assessment_evidence", "decision_state"
      ],
      "properties": {
        "level": {"enum": ["a1", "a2", "b1", "b2", "c1", "c2"]},
        "progression_index": {"type": "integer", "minimum": 1, "maximum": 6},
        "gse_range": {"type": "string", "pattern": "^[0-9]{2}-[0-9]{2}$"},
        "title": {"type": "string", "minLength": 1},
        "exit_promise": {"$ref": "#/$defs/claim"},
        "reception": {"$ref": "#/$defs/claimPair"},
        "production": {"$ref": "#/$defs/production"},
        "interaction": {"$ref": "#/$defs/interaction"},
        "language_control": {"$ref": "#/$defs/languageControl"},
        "assessment_evidence": {
          "type": "array", "minItems": 3, "items": {"$ref": "#/$defs/claim"}
        },
        "decision_state": {"const": "accepted"}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reviewer", "reviewed_at", "method", "issues"],
      "properties": {
        "status": {"const": "accepted"},
        "reviewer": {"const": "codex_primary_curriculum_agent"},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "method": {"const": "claim_by_claim_source_boundary_review"},
        "issues": {"type": "array", "maxItems": 0}
      }
    }
  }
}
